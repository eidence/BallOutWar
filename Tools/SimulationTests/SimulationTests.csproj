<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the engine-free simulation tests outside Unity: dotnet test Tools/SimulationTests
    Compiles the same source files Unity uses, with Unity's C# language level.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>BOW.Simulation.Tests</AssemblyName>
    <RootNamespace>BOW.Simulation.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Simulation/**/*.cs" Exclude="../../Assets/Scripts/Simulation/AssemblyInfo.cs" />
    <Compile Include="../../Assets/Scripts/AI/**/*.cs" Exclude="../../Assets/Scripts/AI/AssemblyInfo.cs" />
    <Compile Include="../../Assets/Tests/EditMode/AI/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/Simulation/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
